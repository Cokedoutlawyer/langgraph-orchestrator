{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hybrid Decision 1.0.0",
  "type": "object",
  "required": [
    "decision_id",
    "workflow_id",
    "run_id",
    "transition",
    "outcome",
    "confidence",
    "provider",
    "provider_policy_version",
    "contract_version",
    "inputs_digest",
    "evidence",
    "receipt",
    "gaps",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provider": {
      "enum": [
        "laya",
        "jev"
      ]
    },
    "provider_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "inputs_digest": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "provider_receipt_id",
        "raw_digest"
      ],
      "properties": {
        "provider_receipt_id": {
          "type": "string"
        },
        "raw_digest": {
          "type": "string"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "escalation_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
